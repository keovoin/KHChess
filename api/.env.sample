# KHChess API environment variables.
# For local dev: copy to `.env`. For Fly.io: set the SECRET ones with `fly secrets set`.

# --- AI provider keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Auth (JWT signing for app tokens) ---
JWT_SECRET=
JWT_EXPIRATION=30d

# --- Supabase (OAuth / user auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stockfish engine ---
# In the Docker/Fly image this is baked in at /app/api/lib/stockfish.
# For local dev, point it at your local binary (e.g. `which stockfish`).
STOCKFISH_BIN_PATH=/app/api/lib/stockfish

# --- Server ---
PORT=3000
