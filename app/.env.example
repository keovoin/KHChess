# ------------------------------------------------------------------
# KHChess — app (frontend) environment
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
#
# NEVER commit your real .env. Only .env.example is tracked.
# ------------------------------------------------------------------

# Backend API base path (reverse-proxy prefix used by Vercel)
VITE_API_URL=/api

# WebSocket path for live game streams
VITE_SOCKET_URL=/ws

# ------------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------
# Google OAuth ("Continue with Google")
# ------------------------------------------------------------------
# No extra env vars needed here — the app calls
# supabaseClient.auth.signInWithOAuth({ provider: 'google' }).
#
# One-time setup in the Supabase dashboard:
#   1. Auth → Providers → Google → Enable
#   2. Add your Google Cloud OAuth credentials (Google Console:
#      OAuth client ID/Secret for "Web application")
#   3. Add the redirect URL:  https://YOUR-DEPLOYED-DOMAIN/auth/callback
#      (also http://localhost:5173/auth/callback for local dev)
#   4. In Google Console, add the same redirect URIs to the OAuth
#      client, then test with a Google account.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Admin panel (/admin)
# ------------------------------------------------------------------
# Comma-separated list of email addresses allowed to open /admin.
# Anyone signed in with one of these emails sees the Admin button.
# Leave empty to disable the admin panel entirely.
VITE_ADMIN_EMAILS=
